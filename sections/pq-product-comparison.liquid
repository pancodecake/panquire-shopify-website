<section class="pq pq-section pq-comparison" style="--pq-space: {{ section.settings.spacing }}px;">
  <div class="pq-container">
    <h2 class="pq-product-heading" id="Compare-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<p class="pq-product-intro">{{ section.settings.text | escape }}</p>{% endif %}
    <div class="pq-comparison-scroll" tabindex="0" role="region" aria-labelledby="Compare-{{ section.id }}">
      <table>
        <caption class="visually-hidden">{{ section.settings.heading | escape }}</caption>
        <thead><tr><th scope="col">{{ section.settings.feature_label | escape }}</th>
          <th scope="col"><div class="pq-comparison-image">{% render 'pq-media', image: section.settings.image_a, label: section.settings.model_a, sizes: '320px' %}</div>{{ section.settings.model_a | escape }}</th>
          <th scope="col"><div class="pq-comparison-image">{% render 'pq-media', image: section.settings.image_b, label: section.settings.model_b, sizes: '320px' %}</div>{{ section.settings.model_b | escape }}</th>
        </tr></thead>
        <tbody>{% for block in section.blocks %}<tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label | escape }}</th><td>{{ block.settings.value_a | escape }}</td><td>{{ block.settings.value_b | escape }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
    {% if section.settings.note != blank %}<p class="pq-comparison-note">{{ section.settings.note | escape }}</p>{% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Panquire model comparison","max_blocks":24,
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Find your ride"},
    {"type":"textarea","id":"text","label":"Introduction"},
    {"type":"text","id":"feature_label","label":"Feature column label","default":"Feature"},
    {"type":"text","id":"model_a","label":"First model","default":"Panquire 01"},
    {"type":"image_picker","id":"image_a","label":"First model image"},
    {"type":"text","id":"model_b","label":"Second model","default":"Panquire 02"},
    {"type":"image_picker","id":"image_b","label":"Second model image"},
    {"type":"textarea","id":"note","label":"Footnote","default":"Specifications will be added when product details are available."},
    {"type":"range","id":"spacing","label":"Section spacing","min":20,"max":160,"step":10,"unit":"px","default":70}
  ],
  "blocks":[{"type":"row","name":"Comparison row","settings":[
    {"type":"text","id":"label","label":"Feature","default":"Motor"},
    {"type":"text","id":"value_a","label":"First model value","default":"Coming soon"},
    {"type":"text","id":"value_b","label":"Second model value","default":"Coming soon"}
  ]}],
  "presets":[{"name":"Panquire model comparison","blocks":[{"type":"row"}]}]
}
{% endschema %}
