<section class="pq pq-section pq-product-specs" style="--pq-space: {{ section.settings.spacing }}px;">
  <div class="pq-container">
    <h2 class="pq-product-heading">{{ section.settings.heading | escape }}</h2>
    <div class="pq-specification-panel">
      <div class="pq-specification-image">{% render 'pq-media', image: section.settings.image, label: section.settings.media_label, sizes: '(min-width: 750px) 480px, 100vw' %}</div>
      <div class="pq-specification-groups">
        {% for block in section.blocks %}
          <details class="pq-specification-group" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading | escape }}</summary>
            {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
            {% assign rows = block.settings.rows | newline_to_br | split: '<br />' %}
            <dl>{% for row in rows %}{% assign pair = row | split: '|' %}{% if pair.size > 1 %}<div><dt>{{ pair[0] | strip | escape }}</dt><dd>{{ pair[1] | strip | escape }}</dd></div>{% endif %}{% endfor %}</dl>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Panquire specifications","max_blocks":8,
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Specs & parameters"},
    {"type":"image_picker","id":"image","label":"Size diagram"},
    {"type":"text","id":"media_label","label":"Placeholder label","default":"Dimension diagram placeholder"},
    {"type":"range","id":"spacing","label":"Section spacing","min":20,"max":160,"step":10,"unit":"px","default":80}
  ],
  "blocks":[{"type":"group","name":"Specification group","settings":[
    {"type":"text","id":"heading","label":"Heading","default":"Size & fit"},
    {"type":"richtext","id":"text","label":"Description"},
    {"type":"textarea","id":"rows","label":"Specifications","info":"One per line: Label | Value","default":"Overall length | Coming soon\nSeat height | Coming soon\nWheelbase | Coming soon"}
  ]}],
  "presets":[{"name":"Panquire specifications","blocks":[{"type":"group"}]}]
}
{% endschema %}
