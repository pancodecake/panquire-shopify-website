        "payment": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Payment",
            "anchor": "payment"
          },
          "blocks": {
            "payment_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What currencies does Shopify display and charge?",
                "answer": "<p>USD or EUR.</p>"
              }
            },
            "payment_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What payment methods do you accept through Shopify?",
                "answer": "<p>Direct payment when placing the order.</p>"
              }
            },
            "payment_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do you offer financing or installment payments? If yes, who is the provider?",
                "answer": "<p>No.</p>"
              }
            },
            "payment_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When is the customer charged?",
                "answer": "<ul><li>At checkout.</li><li>When the order is accepted: <strong>Yes</strong>.</li><li>When the product is shipped.</li><li>Other.</li></ul>"
              }
            },
            "payment_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do you accept deposits or pre-orders?",
                "answer": "<p>Yes.</p>"
              }
            },
            "payment_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "If accepted, is the deposit refundable, transferable, or non-refundable?",
                "answer": "<p>Transferable.</p>"
              }
            },
            "payment_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are prices inclusive of sales tax or VAT, or is tax added at checkout?",
                "answer": "<p>No additional taxes are charged.</p>"
              }
            },
            "payment_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who bears tariffs, import taxes, customs fees, and other international charges?",
                "answer": "<p>The seller/we bear them.</p>"
              }
            },
            "payment_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Is shipping shown at checkout or calculated separately?",
                "answer": "<p>Shipping is shown at checkout.</p>"
              }
            },
            "payment_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are failed, voided, disputed, or charged-back payments handled?",
                "answer": "<p>[Not specified in source]</p>"
              }
            },
            "payment_11": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Do you manually adjust order prices after checkout?",
                "answer": "<p>[Not specified in source]</p>"
              }
            },
            "payment_12": {
              "type": "pq-policy-question",
              "settings": {
                "question": "After an approved cancellation or return, how long does a refund usually take?",
                "answer": "<p>1–3 days.</p>"
              }
            }
          },
