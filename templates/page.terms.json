        "returns-refunds": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Returns and Refunds",
            "anchor": "returns-refunds"
          },
          "blocks": {
            "returns_refunds_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is the return period, and when does it start?",
                "answer": "<ul><li>Order date.</li><li>Delivery date: <strong>7 days for non-quality issues</strong>.</li><li>First attempted delivery date.</li></ul>"
              }
            },
            "returns_refunds_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Which products can be returned? This includes assembled or ridden vehicles, batteries, chargers, parts, accessories, clothing, and opened packaging.",
                "answer": "<p>Quality issues can be returned within <strong>3 days of receipt</strong>.</p>"
              }
            },
            "returns_refunds_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What condition must the product be in? Must original packaging be retained?",
                "answer": "<p>Original packaging must be retained.</p>"
              }
            },
            "returns_refunds_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are restocking, inspection, repackaging, or depreciation fees charged?",
                "answer": "<p>No.</p>"
              }
            },
            "returns_refunds_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who bears return shipping? Is it different for non-quality, defective, wrong, or damaged products?",
                "answer": "<p>Non-quality issues: <strong>Buyer</strong>.</p><p>Defective or wrong product: <strong>Seller</strong>.</p>"
              }
            },
            "returns_refunds_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are deposits or pre-order payments refundable?",
                "answer": "<p>Yes.</p>"
              }
            },
            "returns_refunds_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are custom, modified, clearance, final-sale, or used products excluded from returns?",
                "answer": "<p>Quality issues can be returned; non-quality issues cannot.</p>"
              }
            },
            "returns_refunds_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is the return authorization and submission process? Include the return address and the return deadline after approval.",
                "answer": "<p>Upload photos/videos to the website; the return address is sent separately to the customer.</p>"
              }
            },
            "returns_refunds_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are returned products inspected? How are incomplete, damaged, modified, or excessively used products handled?",
                "answer": "<p>[Not specified in source]</p>"
              }
            },
            "returns_refunds_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When and how are refunds issued? Does it include original shipping?",
                "answer": "<p>1–3 days.</p>"
              }
            },
            "returns_refunds_11": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are tariffs, import taxes, customs fees, or international shipping refundable?",
                "answer": "<p>No.</p>"
              }
            },
            "returns_refunds_12": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are defective products handled?",
                "answer": "<p>Destroy directly.</p>"
              }
            },
            "returns_refunds_13": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How are products damaged during return shipping handled?",
                "answer": "<p>Same as above; not repeated.</p>"
              }
            },
            "returns_refunds_14": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are exchanges offered, or must the original product be returned and a new order placed?",
                "answer": "<p>The original product must be returned and a new order placed for shipment.</p>"
              }
            },
            "returns_refunds_15": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What rights apply when a product is defective or not as described?",
                "answer": "<p>[Not specified in source]</p>"
              }
            },
            "returns_refunds_16": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What statutory cancellation or cooling-off rights apply in the country of sale?",
                "answer": "<p>[Not specified in source]</p>"
              }
            }
