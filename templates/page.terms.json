        "warranty": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Warranty",
            "anchor": "warranty"
          },
          "blocks": {
            "warranty_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Which products and components are covered, and what is the warranty period for each?",
                "answer": "<ul><li>Complete vehicle: <strong>2 years</strong></li><li>Battery: <strong>2 years</strong></li><li>Motor: <strong>2 years</strong></li><li>Controller: <strong>2 years</strong></li><li>Charger: <strong>2 years</strong></li><li>Frame: <strong>2 years</strong></li><li>Electronic components: <strong>2 years</strong></li><li>Parts and accessories: Tires, brakes, and wear parts are <strong>not covered</strong>.</li></ul>"
              }
            },
            "warranty_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When does the warranty start?",
                "answer": "<ul><li>Purchase date.</li><li>Delivery date: <strong>Starts on delivery date</strong>.</li><li>Registration date.</li><li>First use date.</li></ul>"
              }
            },
            "warranty_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Does the warranty require proof of purchase or product registration?",
                "answer": "<p>Proof of purchase is required.</p>"
              }
            },
            "warranty_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who is eligible for warranty, and can the warranty be transferred to a subsequent owner?",
                "answer": "<p>Cannot be transferred to a subsequent owner.</p>"
              }
            },
            "warranty_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What defects or failures are covered? Does it include parts, labor, diagnostic fees, and shipping?",
                "answer": "<p>[Not specified in source]</p>"
              }
            },
            "warranty_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "For an approved warranty repair or replacement, who bears shipping?",
                "answer": "<p>We provide new parts for replacement.</p>"
              }
            },
            "warranty_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What is the warranty claim process? Where should claims be submitted?",
                "answer": "<p>On the website or by phone/video.</p>"
              }
            },
            "warranty_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What documents, photos, videos, serial numbers, or diagnostic information are required for warranty claims?",
                "answer": "<p>[Not specified in source]</p>"
              }
            },
            "warranty_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Is prior authorization required before returning a product?",
                "answer": "<p>Yes.</p>"
              }
            },
            "warranty_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who performs warranty repairs?",
                "answer": "<ul><li>Manufacturer.</li><li>Authorized service center: <strong>Yes</strong>.</li><li>Customer.</li></ul>"
              }
            },
            "warranty_11": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are replacement parts or repaired products new, refurbished, or equivalent?",
                "answer": "<p>New.</p>"
              }
            },
            "warranty_12": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Which events or conditions void or are not covered by warranty?",
                "answer": "<ul><li>Accident or collision: <strong>No</strong></li><li>Competition or racing use: <strong>No</strong></li><li>Misuse or abuse: <strong>No</strong></li><li>Water or moisture damage: <strong>No</strong></li><li>Unauthorized modification: <strong>No</strong></li><li>Improper assembly: <strong>No</strong></li><li>Improper maintenance: <strong>No</strong></li><li>Normal wear: <strong>No</strong></li><li>Use of incompatible parts or charger: <strong>No</strong></li></ul>"
              }
            },
            "warranty_13": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Which parts are normal wear items?",
                "answer": "<p>Tires, brake pads, chain.</p>"
              }
            },
            "warranty_14": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Is battery capacity decline or reduced range covered?",
                "answer": "<p>Covered within a reasonable range.</p>"
              }
            },
            "warranty_15": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are software or firmware issues covered?",
                "answer": "<p>Yes.</p>"
              }
            },
            "warranty_16": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Does repair or replacement restart or extend the warranty?",
                "answer": "<p>Replaced parts restart the warranty.</p>"
              }
            },
            "warranty_17": {
              "type": "pq-policy-question",
              "settings": {
                "question": "If the product cannot be repaired, what happens?",
                "answer": "<p>Explain the situation and why it cannot be repaired.</p>"
              }
            },
            "warranty_18": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are statutory or legally required consumer warranty rights retained?",
                "answer": "<p>[Not specified in source]</p>"
              }
            }
          },
