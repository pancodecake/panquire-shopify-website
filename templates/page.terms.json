        "shipping": {
          "type": "pq-policy-category",
          "settings": {
            "heading": "Shipping",
            "anchor": "shipping"
          },
          "blocks": {
            "shipping_1": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Which countries, states, provinces, or regions do you ship to?",
                "answer": "<p>U.S. West Coast / Europe: Germany or Poland.</p>"
              }
            },
            "shipping_2": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Which carriers and shipping methods do you use?",
                "answer": "<p>FedEx.</p>"
              }
            },
            "shipping_3": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are complete electric off-road motorcycles shipped by freight, express, or both?",
                "answer": "<p>Both.</p>"
              }
            },
            "shipping_4": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Are there separate shipping or dangerous goods restrictions for batteries?",
                "answer": "<p>Batteries have separate dangerous goods certificates.</p>"
              }
            },
            "shipping_5": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What shipping rates or shipping rules are available?",
                "answer": "<p>[Not specified in source]</p>"
              }
            },
            "shipping_6": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Will customers receive tracking information?",
                "answer": "<p>Yes.</p>"
              }
            },
            "shipping_7": {
              "type": "pq-policy-question",
              "settings": {
                "question": "If an order is delayed, lost, or shows delivered but the customer did not receive it, what should the customer do?",
                "answer": "<p>Claim with the courier or insurance.</p>"
              }
            },
            "shipping_8": {
              "type": "pq-policy-question",
              "settings": {
                "question": "If the vehicle or package arrives visibly damaged, what must the customer do?",
                "answer": "<p>Take photos/videos; it can be returned and reshipped.</p>"
              }
            },
            "shipping_9": {
              "type": "pq-policy-question",
              "settings": {
                "question": "How long does the customer have to report shipping damage?",
                "answer": "<p>1–3 days.</p>"
              }
            },
            "shipping_10": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What photos or documents are required for shipping damage claims?",
                "answer": "<p>Take photos/videos of all damaged parts upon receipt.</p>"
              }
            },
            "shipping_11": {
              "type": "pq-policy-question",
              "settings": {
                "question": "Who bears return shipping costs in the following cases?",
                "answer": "<ul><li>Non-quality return: <strong>Buyer</strong></li><li>Defective product: <strong>Seller</strong></li><li>Wrong product: <strong>Seller</strong></li><li>Shipping damage: <strong>Seller</strong></li></ul>"
              }
            },
            "shipping_12": {
              "type": "pq-policy-question",
              "settings": {
                "question": "When do ownership and risk transfer to the customer?",
                "answer": "<p>After full payment, ownership belongs to the customer.</p><p>Risk transfer: [Not specified in source]</p>"
              }
            },
            "shipping_13": {
              "type": "pq-policy-question",
              "settings": {
                "question": "What trust badges and qualifications can we show buyers?",
                "answer": "<p>Provide their names and corresponding documents.</p>"
              }
            }
          },
